---
import BaseLayout from '../layouts/BaseLayout.astro';
import Demo from '../typst/demo.typ';
---

<BaseLayout
  title="Typst — spiritofstar"
  description="A live Typst typesetting demo, rendered server-side to SVG with astro-typst."
>
  <main class="typst-demo">
    <div class="demo-intro">
      <h1>Typst on this site</h1>
      <p class="demo-desc">
        This page is a <code>.typ</code> file rendered to SVG at build time by
        <a href="https://github.com/OverflowCat/astro-typst">astro-typst</a>.
        The same source compiles to a standalone PDF with the Typst CLI —
        compare the two outputs side by side.
      </p>
      <div class="demo-actions">
        <a href="/demo.pdf">Download PDF</a>
        <a href="https://typst.app">Edit in typst.app</a>
      </div>
    </div>
    <div class="typst-frame">
      <Demo />
    </div>
  </main>
</BaseLayout>
